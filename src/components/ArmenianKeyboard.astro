---
import { HY_LETTERS, HY_PUNCTUATION } from '../data/alphabet';
import { t } from '../lib/i18n';

const keys = [...HY_LETTERS, 'ու', ...HY_PUNCTUATION];
---

<div class="hy-keyboard-wrap" data-hy-keyboard hidden>
  <div class="hy-keyboard" role="group" aria-label="Teclado armenio / Armenian keyboard">
    {
      keys.map((char) => (
        <button type="button" class="hy-keyboard__key" data-hy-char={char}>
          {char}
        </button>
      ))
    }
    <button type="button" class="hy-keyboard__key" data-hy-space aria-label="Espacio / Space">
      ␣
    </button>
    <button
      type="button"
      class="hy-keyboard__key"
      data-hy-backspace
      aria-label={t('keyboard.backspace', 'es')}
      data-i18n-aria-label="keyboard.backspace">⌫</button
    >
  </div>
</div>
