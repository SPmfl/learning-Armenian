---
interface Props {
  done: number;
  total: number;
  size?: number;
  label?: string;
}

const { done, total, size = 56, label } = Astro.props;
const fraction = total > 0 ? Math.min(done / total, 1) : 0;
const radius = (size - 8) / 2;
const circumference = 2 * Math.PI * radius;
const text = label ?? `${done}/${total}`;
---

<span
  class="progress-ring"
  data-ring
  style={`--ring-len:${circumference};--ring-pct:${fraction}`}
>
  <svg
    class="progress-ring__svg"
    width={size}
    height={size}
    viewBox={`0 0 ${size} ${size}`}
    aria-hidden="true"
  >
    <circle
      class="progress-ring__track"
      cx={size / 2}
      cy={size / 2}
      r={radius}
      fill="none"
      stroke-width="6"></circle>
    <circle
      class="progress-ring__bar"
      cx={size / 2}
      cy={size / 2}
      r={radius}
      fill="none"
      stroke-width="6"
      stroke-linecap="round"
      stroke-dasharray={String(circumference)}></circle>
  </svg>
  <span class="progress-ring__value" data-ring-label>{text}</span>
</span>
