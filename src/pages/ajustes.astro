---
import MainLayout from '../layouts/MainLayout.astro';
import { t } from '../lib/i18n';

const themes: Array<{ value: string; key: string }> = [
  { value: 'auto', key: 'settings.theme.auto' },
  { value: 'light', key: 'settings.theme.light' },
  { value: 'dark', key: 'settings.theme.dark' },
];
---

<MainLayout title={`${t('settings.title', 'es')} — ${t('app.title', 'es')}`}>
  <h1 data-i18n="settings.title">{t('settings.title', 'es')}</h1>

  <div class="card">
    <div class="field">
      <label for="settings-lang" data-i18n="settings.language">{t('settings.language', 'es')}</label>
      <select id="settings-lang">
        <option value="es">Español</option>
        <option value="en">English</option>
      </select>
    </div>

    <div class="field">
      <label for="settings-theme" data-i18n="settings.theme">{t('settings.theme', 'es')}</label>
      <select id="settings-theme">
        {themes.map((theme) => <option value={theme.value} data-i18n={theme.key}>{t(theme.key, 'es')}</option>)}
      </select>
    </div>

    <p class="muted" data-i18n="settings.fontFallback">{t('settings.fontFallback', 'es')}</p>
  </div>

  <h2 data-i18n="settings.data">{t('settings.data', 'es')}</h2>
  <div class="card">
    <p
      class="notice notice--warn"
      data-progress-warning-full
      hidden
      data-i18n="progress.memoryUnavailable"
    >
      {t('progress.memoryUnavailable', 'es')}
    </p>
    <p>
      <button class="btn" type="button" data-export data-i18n="action.export">
        {t('action.export', 'es')}
      </button>
      <label class="btn">
        <span data-i18n="action.import">{t('action.import', 'es')}</span>
        <input type="file" accept="application/json,.json" data-import hidden />
      </label>
      <button class="btn btn--danger" type="button" data-reset data-i18n="action.reset">
        {t('action.reset', 'es')}
      </button>
    </p>
    <p class="muted" data-data-status role="status" aria-live="polite"></p>
  </div>

  <script>
    import '../scripts/settings.ts';
    import '../scripts/data-controls.ts';
  </script>
</MainLayout>
