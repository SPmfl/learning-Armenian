---
import LessonCard from '../../components/LessonCard.astro';
import ProgressRing from '../../components/ProgressRing.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { loadCurriculum } from '../../lib/content';
import { buildMeta, unitLessons } from '../../lib/curriculum';
import { t } from '../../lib/i18n';
import { href } from '../../lib/url';

const { units, lessons } = await loadCurriculum();
const meta = buildMeta(units, lessons);
const jsonMeta = JSON.stringify(meta).replace(/</g, '\\u003c');
---

<MainLayout title={`${t('nav.lessons', 'es')} — ${t('app.title', 'es')}`}>
  <h1 data-i18n="nav.lessons">{t('nav.lessons', 'es')}</h1>

  {
    units.map((unit) => (
      <section class="card" data-unit-id={unit.id}>
        <div class="row-between">
          <div>
            <p class="eyebrow" data-i18n="lesson.unit">
              {t('lesson.unit', 'es')} {unit.order}
            </p>
            <h2>
              <a href={href(`/unidades/${unit.id}`)}>
                <span data-gloss-lang="es">{unit.title.es}</span>
                <span data-gloss-lang="en">{unit.title.en}</span>
              </a>
            </h2>
            <p class="card__meta">
              <span data-gloss-lang="es">{unit.description.es}</span>
              <span data-gloss-lang="en">{unit.description.en}</span>
            </p>
          </div>
          <ProgressRing done={0} total={unitLessons(unit.id, lessons).length} size={56} />
        </div>

        <p>
          <span class="status-badge" data-unit-lock hidden data-i18n="state.locked">
            {t('state.locked', 'es')}
          </span>
        </p>

        <ul class="list-plain">
          {unitLessons(unit.id, lessons).map((lesson) => <LessonCard lesson={lesson} />)}
        </ul>
      </section>
    ))
  }

  <script type="application/json" id="curriculum-meta" set:html={jsonMeta}></script>
  <script>
    import '../../scripts/progress-view.ts';
  </script>
</MainLayout>
