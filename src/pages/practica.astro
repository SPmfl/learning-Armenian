---
import MainLayout from '../layouts/MainLayout.astro';
import { loadCurriculum } from '../lib/content';
import { buildPool } from '../lib/curriculum';
import { t } from '../lib/i18n';

const { units, lessons } = await loadCurriculum();
const pool = buildPool(lessons);
const tags = [...new Set(pool.flatMap((card) => card.tags))].sort();

const payload = JSON.stringify({
  pool,
  units: units.map((unit) => ({ id: unit.id, es: unit.title.es, en: unit.title.en })),
  tags,
}).replace(/</g, '\\u003c');
---

<MainLayout title={`${t('practice.title', 'es')} — ${t('app.title', 'es')}`}>
  <h1 data-i18n="practice.title">{t('practice.title', 'es')}</h1>

  <form class="card" id="practice-controls">
    <div class="field">
      <label for="practice-mode" data-i18n="practice.mode">{t('practice.mode', 'es')}</label>
      <select id="practice-mode">
        <option value="review" data-i18n="practice.mode.review">
          {t('practice.mode.review', 'es')}
        </option>
        <option value="free" data-i18n="practice.mode.free">{t('practice.mode.free', 'es')}</option>
      </select>
    </div>

    <div class="field">
      <label for="practice-source" data-i18n="practice.source">{t('practice.source', 'es')}</label>
      <select id="practice-source">
        <option value="all" data-i18n="practice.source.all">
          {t('practice.source.all', 'es')}
        </option>
        {units.map((unit) => <option value={`unit:${unit.id}`}>{`${unit.title.es} / ${unit.title.en}`}</option>)}
        {tags.map((tag) => <option value={`tag:${tag}`}>{tag}</option>)}
        <option value="starred" data-i18n="practice.source.starred">
          {t('practice.source.starred', 'es')}
        </option>
      </select>
    </div>

    <div class="field">
      <label for="practice-size" data-i18n="practice.size">{t('practice.size', 'es')}</label>
      <select id="practice-size">
        <option value="10">10</option>
        <option value="20" selected>20</option>
        <option value="50">50</option>
        <option value="0" data-i18n="practice.size.all">{t('practice.size.all', 'es')}</option>
      </select>
    </div>

    <p>
      <button class="btn btn--primary" type="submit" data-practice-start data-i18n="practice.start">
        {t('practice.start', 'es')}
      </button>
    </p>
  </form>

  <section id="practice-session" aria-live="polite"></section>
  <noscript>
    <p class="notice">Activa JavaScript para practicar con tarjetas de vocabulario.</p>
  </noscript>

  <script type="application/json" id="practice-pool" set:html={payload}></script>
  <script>
    import '../scripts/practice.ts';
  </script>
</MainLayout>
